# docker-compose.override.yml.example
# 
# Copy this file to docker-compose.override.yml and customize as needed
# This file allows you to override default settings without modifying the main docker-compose.yml
#
# Usage: cp docker-compose.override.yml.example docker-compose.override.yml

version: '3.8'

services:
  # Example: Change backend port
  # backend:
  #   ports:
  #     - "8001:8000"

  # Example: Change frontend port
  # frontend:
  #   ports:
  #     - "3000:5173"

  # Example: Add custom PHP configuration
  # backend:
  #   volumes:
  #     - ./docker/backend/custom-php.ini:/usr/local/etc/php/conf.d/custom.ini

  # Example: Change MySQL root password
  # mysql:
  #   environment:
  #     MYSQL_ROOT_PASSWORD: your_custom_password

  # Example: Mount custom nginx config
  # nginx:
  #   volumes:
  #     - ./docker/nginx/custom.conf:/etc/nginx/conf.d/default.conf
